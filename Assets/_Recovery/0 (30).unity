  m_Script: {fileID: 11500000, guid: 9d454f9c6393fe246895688f3ba2e6fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableItem
  promptMessage: "L\xE1 th\u01B0"
  documentImage: {fileID: 21300000, guid: b35028cc2f13c134db14baa8d7b82630, type: 3}
  documentContent: "Con zai \xE0. B\u1ED1 \u0111ang c\xF3 chuy\u1EBFn \u0111i du
    l\u1ECBch.V\xEC b\u1ED1 th\u1EA5y con nh\xE0n r\u1ED7i qu\xE1 n\xEAn g\u1EEDi
    con \u0111\u1EBFn nh\xE0 c\u0169 c\u1EE7a \xF4ng b\xE0. Con zai c\u1ED1 g\u1EAFng
    sinh t\u1ED3n \u1EDF \u0111\xE2y nh\xE9. Bao gi\u1EDD b\u1ED1 c\xF3 h\u1EE9ng
    th\xEC \u0111\u1EBFn \u0111\xF3n con.\nM\xE0 mu\u1ED1n v\u1EC1 nh\xE0 th\xEC
    ph\u1EA3i c\xE2u \u0111\u01B0\u1EE3c 6 con pet c\u1EE7a \xF4ng b\xE0, m\u1EA5y
    con God Sea ngo\xE0i bi\u1EC3n \u1EA5y.\nB\u1ED1 c\xF3 vi\u1EBFt th\xEAm quy\u1EC3n
    d\u1EA1y sinh t\u1ED3n \u0111\xF3, nh\u1EDB \u0111\u1ECDc k\u0129 nha con zai.\n\n\n-
    B\u1ED1 sigma"
